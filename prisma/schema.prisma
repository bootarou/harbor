// Prisma schema for the Symbol(XYM) tipping blog.
// NOTE: 秘密鍵・ニーモニックはサーバーに保存しない。User に保持するのは公開アドレス(xymAddress)のみ。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String    @id @default(cuid())
  // ===== DID（Symbolアドレス）認証 =====
  symbolAddress             String?   @unique // ログイン主識別子（DID address）。plain 39文字
  did                       String? // did:symbol:{network}:{address}
  network                   String? // testnet / mainnet
  publicKey                 String? // 署名検証用の公開鍵
  lastLoginAt               DateTime?
  // ===== メール（任意・ログインIDではない） =====
  email                     String?   @unique
  emailVerified             Boolean   @default(false)
  emailNotificationsEnabled Boolean   @default(false)
  passwordHash              String? // 旧メール認証の名残（DID移行後は未使用）
  // ===== プロフィール =====
  displayName               String
  avatarUrl                 String?
  coverImage                String? // プロフィールのカバー画像（公開ページのバナー・OGP用）
  bio                       String?
  xAccount                  String?
  websiteUrl                String? // SMD url
  symbolNamespace           String? // SMD namespace
  profileSource             String? // "smd" 等
  smdSyncedAt               DateTime?
  xymAddress                String? // 受取アドレス（通常 symbolAddress と同一）
  tokushoho                 String? // 特定商取引法に基づく表記（テキスト/Markdown・HTML不可）
  salesTerms                String? // 利用規約・販売条件（テキスト/Markdown・HTML不可）
  notificationsReadAt       DateTime? // （旧）通知を最後に確認した時刻
  notificationPrefs         Json? // 通知種別ごとの ON/OFF（未設定キーは既定値）
  createdAt                 DateTime  @default(now())

  posts          Post[]
  comments       Comment[]
  sentTips       Tip[]      @relation("SentTips")
  purchases      Purchase[] @relation("Purchases")
  reactions      Reaction[] @relation("Reactions")
  reports        Report[]   @relation("Reports")
  thanksSent     Thanks[]   @relation("ThanksSent")
  thanksReceived Thanks[]   @relation("ThanksReceived")

  following     Follow[]       @relation("Following") // この人がフォローしている関係
  followers     Follow[]       @relation("Followers") // この人がフォローされている関係
  bookmarks     Bookmark[]
  notifications Notification[]
  answers       Answer[]       @relation("Answers")
  pollVotes     PollVote[]
  pushSubscriptions PushSubscription[]
  stamps          Stamp[]          @relation("StampAuthor")
  stampPurchases  StampPurchase[]  @relation("StampBuyer")
  stampPlacements StampPlacement[] @relation("StampPlacer")
  communityTopics   CommunityTopic[]   @relation("CommunityTopicAuthor")
  communityMessages CommunityMessage[] @relation("CommunityMessageAuthor")
  communityTipsSent CommunityTip[]     @relation("CommunityTipSender")
}

// Web Push の購読情報（ブラウザ許可時にクライアントから保存）。
// endpoint がブラウザ/端末ごとの宛先。p256dh/auth はペイロード暗号化用の公開鍵。
// 秘密情報ではなく、サーバーからの送信先＋暗号化鍵のみを保持する。
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// サイト内通知。表示用にアクター名・記事タイトル等をスナップショット保存（FKに依存しない）。
model Notification {
  id        String   @id @default(cuid())
  userId    String // 受信者
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // tip_received | comment | reaction | purchase | new_post | follow
  actorId   String? // 行為者のユーザーID（プロフィール遷移用・FKなし）
  actorName String? // 行為者の表示名（スナップショット）
  postId    String? // 遷移先記事（FKなし）
  postTitle String?
  amount    Decimal? // 投げ銭/購入額
  currency  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Report {
  id             String   @id @default(cuid())
  postId         String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterUserId String?
  reporter       User?    @relation("Reports", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reason         String?
  createdAt      DateTime @default(now())

  @@unique([postId, reporterUserId])
  @@index([postId])
}

model Challenge {
  id        String   @id @default(cuid())
  address   String // ログイン対象アドレス
  network   String
  nonce     String
  message   String // 署名対象メッセージ（サーバー発行・保存）
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([address])
}

// 本文中リンクカード用の OGP キャッシュ。
// 記事保存時に <a data-card> のリンクを取得して格納し、表示時はここから読む
// （表示のたびに外部へ取りに行かない＝高速・レート制限回避）。
model LinkPreview {
  url         String   @id // 正規化済みリンクURL
  title       String?
  description String?
  image       String? // 自前ストレージへ再ホスト済みの画像URL（取得できた場合）
  siteName    String?
  fetchedAt   DateTime @default(now()) // 取得日時（TTL 再取得判定の基準）
}

model AuthLog {
  id        String   @id @default(cuid())
  eventType String // challenge_issued / did_login_success / did_login_failed / did_register / smd_synced / session_revoked
  userId    String?
  address   String?
  ip        String?
  userAgent String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([eventType])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String // フォローする側
  followingId String // フォローされる側
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Post {
  id          String    @id @default(cuid())
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  contentHTML String    @db.Text // 通常公開: 全文 / 販売公開: 試し読み(無料)部分 / URL投稿: 未使用
  coverImage  String?
  published   Boolean   @default(false)
  tags        String[]  @default([])
  publishAt   DateTime? // 公開日時。未来なら未公開扱い。下書き→公開の瞬間に記録する
  editedAt    DateTime? // 本文を編集・保存した日時。updatedAt は閲覧数などでも動くため別に持つ

  // 投稿タイプ: "article"（通常記事） / "external_url"（外部URL共有） / "qa"（質問・回答）
  postType       String  @default("article")
  // QA投稿の状態: "open"（未回答） / "answered"（ベストアンサー選定済み）。qa以外は null。
  qaStatus       String?
  // 外部URL投稿用
  url            String?
  comment        String? @db.Text // 投稿者コメント（プレーンテキスト・表示時エスケープ）
  ogpTitle       String?
  ogpDescription String?
  ogpImageUrl    String?
  ogpSiteName    String?
  tipsEnabled    Boolean @default(true) // URL投稿の投げ銭ON/OFF（通常記事は常に可）
  viewCount      Int     @default(0) // 閲覧数（インプレッション）

  // Harbor Thanks（記事の成長指標）。送金ロジック・金額には一切関与しない表示用メタ。
  thanksCount  Int       @default(0) // 送信済み Thanks 件数（= 感謝した読者数）
  thanksStatus String    @default("docked") // docked/preparing/sailed/voyaging/discovery
  isArchived   Boolean   @default(false) // Harbor Archive（殿堂入り）= thanksStatus="discovery" と同義
  sailedAt     DateTime? // thanksStatus が sailed 以上になった最初の日時（上書きしない）
  archivedAt   DateTime? // thanksStatus が discovery になった日時（= Archive入り日時）

  // アンケート（任意・全投稿タイプ）: 選択肢が2件以上ある時のみ有効。
  pollClosesAt   DateTime? // 投票締め切り（任意・未設定なら無期限）

  // 販売公開（有料記事）関連
  paid          Boolean  @default(false)
  paidHtml      String?  @db.Text // 購入者のみ閲覧できる有料部分
  priceAmount   Decimal?
  priceCurrency String? // "XYM" のみ許可（当面）
  sellerAddress String? // 販売者(投稿者)の受取アドレス

  // 論理削除（ソフトデリート）。null=有効 / 値あり=削除済み。
  // 物理削除しないことで、購入・投げ銭・収益の記録（Purchase/Tip/Thanks）を保全する。
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  Comment[]
  tips      Tip[]
  purchases Purchase[]
  reactions Reaction[]
  reports   Report[]
  thanks    Thanks[]
  bookmarks Bookmark[]
  answers   Answer[]
  pollOptions PollOption[]
  pollVotes   PollVote[]
  stampPlacements StampPlacement[]

  @@index([authorId])
  @@index([published, createdAt])
  @@index([published, publishAt])
  @@index([deletedAt])
  @@index([tags], type: Gin)
  @@index([isArchived])
  @@index([archivedAt])
  @@index([sailedAt])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@index([postId])
}

model Reaction {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("Reactions", fields: [userId], references: [id], onDelete: Cascade)
  type      String // like / empathy / helpful / fun / thanks
  createdAt DateTime @default(now())

  thanks Thanks? // このリアクションに対して送られた Thanks（任意・1件）

  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
}

model Thanks {
  id              String    @id @default(cuid())
  reactionId      String?   @unique
  reaction        Reaction? @relation(fields: [reactionId], references: [id], onDelete: SetNull)
  postId          String
  post            Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  senderUserId    String?
  sender          User?     @relation("ThanksSent", fields: [senderUserId], references: [id], onDelete: SetNull)
  receiverUserId  String?
  receiver        User?     @relation("ThanksReceived", fields: [receiverUserId], references: [id], onDelete: SetNull)
  senderAddress   String
  receiverAddress String
  thanksType      String // thanks / super_thanks
  amount          Decimal
  currency        String
  txHash          String    @unique
  status          String // confirmed / pending
  jpyRate         Decimal?
  createdAt       DateTime  @default(now())

  @@index([receiverUserId])
  @@index([senderUserId])
  @@index([postId])
}

model Purchase {
  id            String   @id @default(cuid())
  postId        String
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  buyerUserId   String?
  buyerUser     User?    @relation("Purchases", fields: [buyerUserId], references: [id], onDelete: SetNull)
  buyerAddress  String
  sellerAddress String
  amount        Decimal
  currency      String
  txHash        String   @unique
  confirmed     Boolean  @default(false)
  jpyRate       Decimal? // 記録時点の XYM/JPY レート（税務の円換算用）
  purchasedAt   DateTime @default(now())

  @@index([postId])
  @@index([buyerUserId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  // メンション先ユーザーの userId 配列（そのスレッド参加者のみ・サーバーで検証）。
  mentions  String[] @default([])
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([userId])
}

model Tip {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  // 回答への投げ銭の場合に設定（記事への投げ銭は null）。QA の回答(Answer)宛て。
  answerId    String?
  answer      Answer?  @relation(fields: [answerId], references: [id], onDelete: SetNull)
  fromAddress String
  toAddress   String
  amount      Decimal
  txHash      String   @unique
  // 送信者ユーザー（履歴表示用。退会等で消えても Tip 自体は残す）
  fromUserId  String?
  fromUser    User?    @relation("SentTips", fields: [fromUserId], references: [id], onDelete: SetNull)
  anonymous   Boolean  @default(false)
  message     String?
  // false: クライアント申告（確認中） / true: ノードのポーリングでオンチェーン確定
  confirmed   Boolean  @default(false)
  jpyRate     Decimal? // 記録時点の XYM/JPY レート（税務の円換算用）
  createdAt   DateTime @default(now()) // 記録時刻（確認中→期限切れ判定の基準）
  confirmedAt DateTime @default(now())

  @@index([postId])
  @@index([answerId])
  @@index([fromUserId])
}

// QA 投稿（postType="qa"）への回答。Comment とは別物（こちらは「回答」）。
model Answer {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation("Answers", fields: [authorId], references: [id], onDelete: Cascade)
  contentHTML String   @db.Text // 保存時に sanitize-html 済み
  isBest      Boolean  @default(false) // 質問者が選んだベストアンサー
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tips Tip[]

  @@index([postId])
  @@index([postId, isBest])
}

// アンケートの選択肢（Twitter風投票）。任意機能で、postType を問わず付与できる。
// label はプレーンテキスト（HTML不可・表示時に React がエスケープ）。
model PollOption {
  id        String     @id @default(cuid())
  postId    String
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  label     String // 選択肢ラベル（プレーンテキスト・最大80文字）
  order     Int        @default(0) // 表示順
  createdAt DateTime   @default(now())

  votes PollVote[]

  @@index([postId])
}

// アンケートへの投票。1ユーザーにつき各投稿で1票のみ（@@unique）。投票後の変更は不可。
model PollVote {
  id        String     @id @default(cuid())
  postId    String
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([postId, userId])
  @@index([optionId])
  @@index([postId])
}

// スタンプ（作者が作成・販売）。購入＝使用権の取得（LINEスタンプに近い・枚数概念なし）。
model Stamp {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation("StampAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String // 500x500 の PNG/GIF/WebP（アップロードAPIで検証済み）
  price       Decimal // XYM価格（作者が自由設定）
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases  StampPurchase[]
  placements StampPlacement[]
  communityMessages CommunityMessage[]

  @@index([authorId])
  @@index([published, createdAt])
}

// スタンプの購入（＝使用権）。1ユーザー1スタンプ1購入・オンチェーン検証で confirmed 化。
model StampPurchase {
  id          String   @id @default(cuid())
  stampId     String
  stamp       Stamp    @relation(fields: [stampId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User     @relation("StampBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  txHash      String   @unique
  amount      Decimal
  confirmed   Boolean  @default(false)
  jpyRate     Decimal?
  purchasedAt DateTime @default(now())

  @@unique([stampId, buyerId]) // 1ユーザー1購入のみ
  @@index([buyerId])
  @@index([stampId])
}

// 記事へのスタンプ貼り付け（送金なし・即時）。同じスタンプを何度でも貼れる（uniqueなし）。
model StampPlacement {
  id        String   @id @default(cuid())
  stampId   String
  stamp     Stamp    @relation(fields: [stampId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("StampPlacer", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([stampId])
  @@index([userId])
}

// コミュニティチャットのトピック（「港の広場」）。誰でも作成可・最終投稿で自動アーカイブ。
model CommunityTopic {
  id           String    @id @default(cuid())
  authorId     String
  author       User      @relation("CommunityTopicAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  iconUrl      String?
  archived     Boolean   @default(false)
  lastPostedAt DateTime? // 最終投稿日時（自動アーカイブ判定・一覧の並び順に使用）
  createdAt    DateTime  @default(now())

  messages CommunityMessage[]

  @@index([archived, lastPostedAt])
  @@index([authorId])
}

// コミュニティチャットのメッセージ。最新100件のみ表示・超過分は物理削除（hidden除く）。
model CommunityMessage {
  id        String         @id @default(cuid())
  topicId   String
  topic     CommunityTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation("CommunityMessageAuthor", fields: [userId], references: [id], onDelete: Cascade)
  body      String         @db.Text
  stampId   String? // 添付スタンプ（任意）
  stamp     Stamp?         @relation(fields: [stampId], references: [id], onDelete: SetNull)
  imageUrl  String? // 添付画像（任意・保存時に長辺500pxへ縮小・圧縮済み）
  hidden    Boolean        @default(false) // 通報による非表示（DBには残す・物理削除の対象外）
  deletedAt DateTime? // 投稿者/トピック作成者による論理削除（チャットから非表示・記録/収益は保持）
  tipTotal  Decimal        @default(0) // 投げ銭合計（表示用の非正規化・確定投げ銭で加算）
  tipCount  Int            @default(0) // 投げ銭した人数（表示用）
  createdAt DateTime       @default(now())

  tips CommunityTip[]

  @@index([topicId, createdAt])
  @@index([userId])
}

// コミュニティチャットのメッセージへの投げ銭（P2P・オンチェーン検証）。
// メッセージは投げ銭が付くと保全対象（物理削除しない）。記録は収益にも計上する。
model CommunityTip {
  id          String           @id @default(cuid())
  messageId   String
  message     CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  topicId     String // 集計/参照用の非正規化
  fromUserId  String? // 送信者（退会耐性で SetNull）
  fromUser    User?            @relation("CommunityTipSender", fields: [fromUserId], references: [id], onDelete: SetNull)
  fromAddress String
  toAddress   String // 受信者＝メッセージ投稿者の xymAddress
  amount      Decimal
  txHash      String           @unique // 二重記録防止
  confirmed   Boolean          @default(false)
  jpyRate     Decimal?
  createdAt   DateTime         @default(now())

  @@index([messageId])
  @@index([topicId])
  @@index([fromUserId])
}
