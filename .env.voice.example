# ===== 音声スタック（docker-compose.voice.yml）専用の環境変数 =====
#
#   cp .env.voice.example .env.voice
#   docker compose -f docker-compose.voice.yml --env-file .env.voice -p harbor-voice up -d
#
# アプリ本体の .env とは別ファイル。testnet / mainnet 双方の LiveKit をここで管理する。

# --- ドメイン ---
# Cloudflare で「DNS only（グレー雲）」にし、自鯖のグローバルIPへ向けたサブドメイン。
# オレンジ雲（プロキシ）のままだと ACME も WebSocket も Cloudflare を経由してしまい繋がらない。
LIVEKIT_DOMAIN_MAIN=livekit.example.com
LIVEKIT_DOMAIN_TEST=livekit-test.example.com

# --- API 鍵（環境ごとに必ず別の値にする）---
# 生成例: openssl rand -hex 16 （SECRET は32文字以上を推奨）
# 鍵を分けることで、片方が漏れてももう片方の音声ルームには入れない。
LIVEKIT_API_KEY_MAIN=
LIVEKIT_API_SECRET_MAIN=
LIVEKIT_API_KEY_TEST=
LIVEKIT_API_SECRET_TEST=
