# ===== ライブトーク（docker-compose.voice.yml）専用の環境変数 =====
#
#   cp .env.voice.example .env.voice
#   docker compose -f docker-compose.voice.yml --env-file .env.voice -p harbor-voice up -d
#
# アプリ本体の .env とは別ファイル。testnet / mainnet 双方の LiveKit をここで管理する。

# --- API 鍵（環境ごとに必ず別の値にする）---
# 生成例: openssl rand -hex 16 （SECRET は32文字以上を推奨）
# 鍵を分けることで、片方が漏れてももう片方のライブトークには入れない。
# ここは**サーバー側のみ**で保持する。ブラウザへは絶対に渡さない
# （ブラウザへ渡すのはサーバーが発行した JWT だけ）。
LIVEKIT_API_KEY_MAIN=
LIVEKIT_API_SECRET_MAIN=
LIVEKIT_API_KEY_TEST=
LIVEKIT_API_SECRET_TEST=

# --- Cloudflare Tunnel の Public Hostname（参考値）---
# シグナリング(WSS)を通すホスト名。Cloudflare Tunnel 側の ingress で
#   livekit.example.com      -> http://livekit-main:7880
#   livekit-test.example.com -> http://livekit-test:7880
# と設定する。compose はこの値を読まないが、各環境の .env の
# LIVEKIT_WS_URL（= wss://<このホスト名>）と一致させること。
LIVEKIT_DOMAIN_MAIN=livekit.example.com
LIVEKIT_DOMAIN_TEST=livekit-test.example.com

# --- シグナリングのホスト側ポート（127.0.0.1 のみに publish）---
# cloudflared をホストOSで動かす場合の接続先。Docker で動かす場合は
# コンテナ名で到達するため触らなくてよい。Internet へは公開しない。
# LIVEKIT_MAIN_SIGNAL_PORT=7880
# LIVEKIT_TEST_SIGNAL_PORT=7883

# --- ICE candidate に広告するグローバルIP（通常は空でよい）---
# 既定は --node-ip=auto で自動検出する。NAT 構成によってはローカルIP
# (192.168.x.x / 10.x.x.x / 172.16-31.x.x) しか candidate に出ないことがある。
# その場合のみ、このサーバーのグローバルIPを設定する。
# ※ Cloudflare のIPを入れてはいけない（メディアは直接接続のため）。
LIVEKIT_NODE_IP=
